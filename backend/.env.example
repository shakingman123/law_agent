# 关系型数据库连接串（开发环境默认 SQLite；生产多用户建议 PostgreSQL，在 .env 中覆盖即可）
# PostgreSQL：DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/law_agent_db
# SQLite：DATABASE_URL=sqlite:///./law_agent.db
# 注意：密码含 @ : / 等特殊字符必须 URL 编码（@ → %40），否则会被当成用户信息/主机分隔符
DATABASE_URL=sqlite:///./law_agent.db

# JWT 签名密钥（生产环境务必替换为强随机值）
SECRET_KEY=change-me-to-a-random-secret-key

# JWT 签名算法
ALGORITHM=HS256

# 访问令牌有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM API Key 加密密钥（Fernet）
# 可使用以下命令生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 若填写非合法 Fernet key，程序会基于该字符串做 SHA256 派生，仍可运行（仅开发环境）
LLM_ENCRYPTION_KEY=replace-with-fernet-key-please

# 跨域允许来源（逗号分隔，开发环境允许 Vite 默认端口）
CORS_ORIGINS=http://localhost:5173

# ClamAV 病毒扫描（留空则使用 TCP；填写路径则用 Unix socket）
# CLAMAV_SOCKET=/var/run/clamav/clamd.ctl
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# MinIO 对象存储（兼容 S3）
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=law-agent
MINIO_SECURE=false

# Qdrant 向量库（法律检索多源 RAG：法条/判例/公众号）
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# 平台开发者 LLM 兜底（仅开发环境，生产环境应留空以强制使用公司/个人配置）
PLATFORM_LLM_API_KEY=
PLATFORM_LLM_BASE_URL=https://api.deepseek.com/v1
PLATFORM_LLM_MODEL=deepseek-chat

# LLM 调用超时（秒）与最大重试次数
# 文书撰写流程串多个 LLM 节点，draft_node 润色长文本常需 30-60s，30s 默认值会触发超时
# 此处与前端 chat.ts 的 LLM_TIMEOUT=120000 对齐
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2

# LangGraph 检查点保存器类型：memory(默认,开发)/sqlite/postgres(生产)
CHECKPOINTER_TYPE=memory
# SQLite 检查点文件路径（CHECKPOINTER_TYPE=sqlite 时生效）
CHECKPOINTER_SQLITE_PATH=checkpoints.db
# PostgreSQL 检查点连接串（留空则复用 DATABASE_URL）
CHECKPOINTER_PG_URL=

# 平台开发者账号（启动时自动播种；不配置则使用代码中的默认值 dev@lawagent.com / dev123456）
# 生产环境务必覆盖默认密码，开发者控制台可审批管理员申请，权限较高
DEVELOPER_EMAIL=dev@lawagent.com
DEVELOPER_PASSWORD=change-me-developer-password
